# 抓取器环境变量（复制为 .env 使用；CI 里配置到 GitHub Secrets）
# Supabase —— 写库用 service role（绝不能提交进 git / 泄漏到前端）
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...（service_role key）
# 只读展示用 anon key（给 site/.env 用）
SUPABASE_ANON_KEY=eyJ...

# Cloudflare R2 图床（S3 兼容）
R2_ACCOUNT_ID=xxxx
R2_ACCESS_KEY_ID=xxxx
R2_SECRET_ACCESS_KEY=xxxx
R2_BUCKET=2kcn
R2_PUBLIC_BASE=https://img.你的域名.dev    # R2 公开桶域名或自定义域

# 抓取节奏（秒）；别低于 1，对上游礼貌
SCRAPE_DELAY=1.5
